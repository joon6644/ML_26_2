# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 커밋하지 않습니다.
# 공공데이터포털(data.go.kr) 일반 인증키 (키 하나로 호출, API별 활용신청 필요)
DATA_GO_KR_API_KEY=
# 팀원 키 (선택): 호출 한도가 키별로 잡히므로 aT 대량 수집 시 순서대로 돌려 씀
DATA_GO_KR_API_KEY_2=
DATA_GO_KR_API_KEY_3=

# KAMIS 농산물유통정보 Open API (https://www.kamis.or.kr/customer/reference/openapi_list.do)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 한국은행 ECOS Open API (https://ecos.bok.or.kr/api/)
ECOS_API_KEY=

# KOSIS 공유서비스 (https://kosis.kr/openapi/)
KOSIS_API_KEY=

# 농림축산식품 공공데이터 포털 (https://data.mafra.go.kr/)
# 키 하나 + 데이터셋별 그리드 ID
# 호출: http://211.237.50.150:7080/openapi/{KEY}/json/{GRID}/{시작}/{끝}
MAFRA_API_KEY=
# 채소류 생산실적
MAFRA_GRID_VEG_PRODUCTION=Grid_20151029000000000254_1
# 농수축산물 도매가격 (필수 파라미터 EXAMIN_DE=YYYYMMDD)
MAFRA_GRID_WHOLESALE_PRICE=Grid_20150406000000000217_1
# 가축질병발생정보
MAFRA_GRID_LIVESTOCK_DISEASE=Grid_20151204000000000316_1
# 레시피 기본정보 / 재료정보 (후순위)
MAFRA_GRID_RECIPE_BASIC=Grid_20150827000000000226_1
MAFRA_GRID_RECIPE_INGREDIENT=Grid_20150827000000000227_1

# 국립수산과학원 Open API (https://www.nifs.go.kr/openApi/actionOpenapiInfoList.do)
# 데이터셋마다 키가 따로 발급됨
# 실시간 해양수산환경 관측시스템 (risaList, risaCode)
NIFS_RISA_API_KEY=
# 적조경보
NIFS_REDTIDE_API_KEY=
# 어장환경관측자료
NIFS_FEMO_API_KEY=
# 해파리정보
NIFS_JELLY_API_KEY=
# 연안정지관측정보
NIFS_COO_API_KEY=

# 오피넷 유가 API (https://www.opinet.co.kr/user/custapi/openApiInfo.do)
OPINET_API_KEY=
